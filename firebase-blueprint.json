{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A construction project containing master RAB, timeline distributions, and daily site reports",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Project title or name",
          "maxLength": 200
        },
        "code": {
          "type": "string",
          "description": "Project code or contract reference",
          "maxLength": 100
        },
        "client": {
          "type": "string",
          "description": "Client or project owner name",
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "description": "Physical location or address of the project",
          "maxLength": 300
        },
        "contractor": {
          "type": "string",
          "description": "Contractor or executing agency name",
          "maxLength": 200
        },
        "startDate": {
          "type": "string",
          "description": "Start date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "endDate": {
          "type": "string",
          "description": "End date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "periodType": {
          "type": "string",
          "description": "Type of time period (weekly or monthly)",
          "enum": ["weekly", "monthly"]
        },
        "totalPeriods": {
          "type": "number",
          "description": "Total duration in periods (weeks)"
        },
        "totalContractValue": {
          "type": "number",
          "description": "Total contract value in IDR currency"
        },
        "ownerId": {
          "type": "string",
          "description": "User UID of the project owner/creator",
          "maxLength": 128
        },
        "lastUpdateDate": {
          "type": "string",
          "description": "Date string of the latest update or daily report",
          "maxLength": 50
        }
      },
      "required": ["id", "name", "code", "client", "startDate", "endDate", "totalPeriods", "totalContractValue"]
    },
    "AuthorizedDevice": {
      "title": "AuthorizedDevice",
      "description": "Security record for hardware devices requesting access with WhatsApp confirmation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique device identifier (e.g., DEV-XXXXX)",
          "maxLength": 128
        },
        "deviceName": {
          "type": "string",
          "description": "Device name or browser OS description",
          "maxLength": 200
        },
        "userAgent": {
          "type": "string",
          "description": "Browser user agent string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Approval status of device",
          "enum": ["pending", "approved", "rejected"]
        },
        "requestedAt": {
          "type": "string",
          "description": "ISO timestamp of when access was requested",
          "maxLength": 50
        },
        "approvedAt": {
          "type": "string",
          "description": "ISO timestamp of approval",
          "maxLength": 50
        },
        "approvedBy": {
          "type": "string",
          "description": "Email or identifier of the approving admin",
          "maxLength": 128
        }
      },
      "required": ["id", "deviceName", "status", "requestedAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of construction projects managed by users"
    },
    "/authorized_devices/{deviceId}": {
      "schema": "AuthorizedDevice",
      "description": "Collection of registered and authorized devices with approval status"
    }
  }
}
