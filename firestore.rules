rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && 
        'email' in request.auth.token && 
        request.auth.token.email.lower() == 'tisnasatrio21@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.code is string && data.code.size() <= 100 &&
             data.client is string && data.client.size() <= 200 &&
             data.startDate is string && data.startDate.size() <= 30 &&
             data.endDate is string && data.endDate.size() <= 30 &&
             data.totalPeriods is number && data.totalPeriods >= 1 && data.totalPeriods <= 500 &&
             data.totalContractValue is number && data.totalContractValue >= 0 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 300)) &&
             (!('contractor' in data) || (data.contractor is string && data.contractor.size() <= 200)) &&
             (!('periodType' in data) || (data.periodType in ['weekly', 'monthly'])) &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
             (!('rabItems' in data) || (data.rabItems is list)) &&
             (!('plannedDistributions' in data) || (data.plannedDistributions is list)) &&
             (!('dailyReports' in data) || (data.dailyReports is list));
    }

    function isValidDevice(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 200 &&
             data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
             data.requestedAt is string && data.requestedAt.size() <= 50 &&
             (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 500)) &&
             (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 50)) &&
             (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 128));
    }

    // Projects collection
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isSignedIn() && isValidId(projectId);
    }

    // Authorized Devices Security Collection
    match /authorized_devices/{deviceId} {
      allow get, list: if true; // Allow client to check its own device approval status
      allow create: if isValidId(deviceId) && isValidDevice(incoming());
      allow update: if isMasterAdmin() || (isValidId(deviceId) && isValidDevice(incoming()));
      allow delete: if isMasterAdmin();
    }
  }
}
